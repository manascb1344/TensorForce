{
	"name": "project",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"clean-start": "rm -rf node_modules && pnpm install && rm -rf $TMPDIR/react* && pnpm dev --reset-cache",
		"build": "vite build",
		"preview": "vite preview",
		"analyze": "vite build --mode analyze",
		"lint": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
		"format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\""
	},
	"dependencies": {
		"@auth0/auth0-react": "^2.2.4",
		"@emailjs/browser": "^4.3.3",
		"@tippyjs/react": "^4.2.6",
		"apisauce": "^3.2.0",
		"axios": "^1.7.9",
		"lottie-react": "^2.4.1",
		"prop-types": "^15.8.1",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-icons": "^5.0.1",
		"react-router-dom": "^6.22.3",
		"react-spinners": "^0.13.8",
		"react-toastify": "^10.0.5",
		"react-tradingview-widget": "^1.3.2"
	},
	"devDependencies": {
