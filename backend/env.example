# Database Configuration
CUSTOMERS_DATABASE_URI=mongodb+srv://username:password@cluster.mongodb.net/customers
MODELS_DATABASE_URI=mongodb+srv://username:password@cluster.mongodb.net/models

# Alpaca API Configuration
